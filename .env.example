# AGNIDRISHTI Environment Configuration Template
# Copy this file to .env and configure your keys

# Production PostgreSQL + PostGIS Database URL
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/agnidrishti

# Allowed CORS Origins (comma-separated for dev and production)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# NASA FIRMS API Key (Map Key for satellite thermal anomaly ingestion)
NASA_FIRMS_API_KEY=
NASA_FIRMS_MAP_KEY=

# Backend Port and API Base URL
BACKEND_PORT=8000
VITE_API_BASE_URL=http://localhost:8000

# Cesium Ion Token (For 3D Cesium World Terrain & OSM Buildings)
VITE_CESIUM_ION_TOKEN=

# Optional Map Providers
VITE_GOOGLE_MAPS_API_KEY=

# Background NASA FIRMS Scheduled Ingestion (Phase 2)
INGESTION_ENABLED=true
INGESTION_INTERVAL_SECONDS=300
